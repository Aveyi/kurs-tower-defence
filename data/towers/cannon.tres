[ext_resource type="PackedScene" path="res://models/towers/cannon_2.glb" id="6_model2"]
[ext_resource type="PackedScene" path="res://models/towers/cannon_3.glb" id="7_model3"]

[sub_resource type="Resource" id="Resource_level1"]
