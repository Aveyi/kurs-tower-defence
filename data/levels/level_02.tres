[resource]
script = ExtResource("1_level")
id = &"haunted_forest"
display_name = "Жуткий лес"
description = "Ночной лес, древние руины и старое кладбище. Мертвецы идут из портала на западе, а после рыцаря-призрака открывается второй — на востоке. В финале — каменный голем."
preview = ExtResource("6_preview")
layout = PackedStringArray("TTTTTTTTTTTTTTTTTTTTTTTT", "T......T.TTTTTT.TT.....T", "TS###.P..R.t.r..t..###sT", "T.TP#L..t..Rt.tP.t.#L..T", "T...#P.GGGG..R..####Pr.T", "T.r.#..GGGGr.tR.#Lt#..TT", "T...#########...#P.#GGTT", "T.P.#..GGGGL#P.t#.R#GG.T", "T...#.PGGGGP#.R.#t.#.R.T", "TT.L#..R..t.#t.r####.TTT", "T.R.#tr.P..t#.P..RP#T.TT", "T...#########.tr...#LP.T", "TT.T.P.rTTP.########..rT", "TTTT..T.TT.CCC.P.rLTTTTT", "TTTTTTTTTTTCCCTTTTTTTTTT")
music = &"battle_haunted"
map_theme = ExtResource("4_theme")
lighting = ExtResource("5_lighting")
hud_style = &"haunted"
start_gold = 350
lives = 20
hp_growth = 0.05
hp_growth_power = 1.25
sealed_portal_wave = 7
decor_seed = 13
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4"), SubResource("Resource_wave5"), SubResource("Resource_wave6"), SubResource("Resource_wave7"), SubResource("Resource_wave8"), SubResource("Resource_wave9"), SubResource("Resource_wave10"), SubResource("Resource_wave11"), SubResource("Resource_wave12")])
