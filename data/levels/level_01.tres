[resource]
script = ExtResource("1_level")
id = &"valley_of_forks"
display_name = "Долина развилок"
description = "Зелёная долина, рассечённая рекой. Дорога от портала трижды разветвляется: враги идут восемью путями, а башни на развилках держат сразу несколько дорог."
