layout = PackedStringArray("TTTTTTTTTTTTTTT~TTTTTTTT", "TTT..######.###=##.....T", "T..P.#.P..#P#..~.#P.T..T", "TS####.TTP###PT~P#.T..TT", "T.r..#P...#.#.r~.#.....T", "T..r.#..P.#P#..~.#.r.T.T", "TT...#r...#.#P.~P#..T..T", "T...P#.P..#.#..~.#P...TT", "T....#....#P###=##..P..T", "T.T..######...P~.######T", "TT.T..P..P..Tr.~.#.P.P#T", "T..T....T...T.T~P#r...#T", "TTT..T.T.rT..T.~.######T", "T.r.T.r....Tr..~T.PCCC.T", "TTTTTTTTTTTTTTT~TTTCCCTT")
start_gold = 250
lives = 20
hp_growth = 0.06
hp_growth_power = 1.35
decor_seed = 7
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4"), SubResource("Resource_wave5"), SubResource("Resource_wave6"), SubResource("Resource_wave7"), SubResource("Resource_wave8"), SubResource("Resource_wave9"), SubResource("Resource_wave10")])
