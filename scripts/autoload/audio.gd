extends Node
## Global audio service (autoload "Audio"): looping music with cross-fades and pooled sound effects.
## All sounds are generated by tools/audio/build_audio.py.

const SFX_PATH := "res://assets/audio/sfx/%s.wav"
const MUSIC_PATH := "res://assets/audio/music/%s.wav"
const SETTINGS_PATH := "user://settings.cfg"
## How many copies of one effect may overlap.
const MAX_VOICES := 4
const SILENT_DB := -50.0

var _players := {}  # StringName -> AudioStreamPlayer
var _last_played := {}  # StringName -> msec
var _music_players: Array[AudioStreamPlayer] = []
var _active_music := 0
var _music_name := &""
var _music_tween: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in 2:
		var player := AudioStreamPlayer.new()
		player.bus = &"Music"
		add_child(player)
		_music_players.append(player)
	_load_settings()


## Plays a sound effect by file name. Repeats of the same sound closer than `min_interval`
## seconds are skipped, so a dozen towers firing at once do not turn into noise.
func play(sound: StringName, volume_db := 0.0, min_interval := 0.05) -> void:
	if sound.is_empty():
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sound, -100000)) < min_interval * 1000.0:
		return
	_last_played[sound] = now
	var player: AudioStreamPlayer = _players.get(sound)
	if player == null:
		player = _make_player(sound)
	player.volume_db = volume_db
	player.play()


func _make_player(sound: StringName) -> AudioStreamPlayer:
	var randomizer := AudioStreamRandomizer.new()
	randomizer.playback_mode = AudioStreamRandomizer.PLAYBACK_RANDOM
	randomizer.add_stream(-1, load(SFX_PATH % sound))
	randomizer.random_pitch = 1.07
	randomizer.random_volume_offset_db = 1.0
	var player := AudioStreamPlayer.new()
	player.stream = randomizer
	player.bus = &"SFX"
	player.max_polyphony = MAX_VOICES
	add_child(player)
	_players[sound] = player
	return player


## Switches the looping background track with a cross-fade.
func play_music(track: StringName, fade := 1.5) -> void:
	if track == _music_name:
		return
	_music_name = track
	var stream: AudioStreamWAV = load(MUSIC_PATH % track)
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)
	var outgoing := _music_players[_active_music]
	_active_music = 1 - _active_music
	var incoming := _music_players[_active_music]
	incoming.stream = stream
	incoming.volume_db = SILENT_DB
	incoming.play()
	_fade_music(incoming, outgoing, fade)


func stop_music(fade := 1.5) -> void:
	_music_name = &""
	_fade_music(null, _music_players[_active_music], fade)


func _fade_music(incoming: AudioStreamPlayer, outgoing: AudioStreamPlayer, fade: float) -> void:
	if _music_tween:
		_music_tween.kill()
	_music_tween = create_tween().set_parallel()
	if incoming:
		_music_tween.tween_property(incoming, "volume_db", 0.0, fade)
	if outgoing and outgoing.playing:
		_music_tween.tween_property(outgoing, "volume_db", SILENT_DB, fade)
		_music_tween.chain().tween_callback(outgoing.stop)


## Click and hover sounds for every Button under `root` (call again for buttons added later).
func wire_buttons(root: Node) -> void:
	for node in root.find_children("*", "BaseButton", true, false):
		var button := node as BaseButton
		if not button.has_meta(&"audio_wired"):
			button.set_meta(&"audio_wired", true)
			button.pressed.connect(play.bind(&"ui_click", 0.0, 0.03))
			button.mouse_entered.connect(func() -> void:
				if not button.disabled:
					play(&"ui_hover", -4.0, 0.03))


# --- volume settings -----------------------------------------------------------------------
## Linear volume 0..1 of an audio bus ("Music" or "SFX").
func get_volume(bus: StringName) -> float:
	return db_to_linear(AudioServer.get_bus_volume_db(AudioServer.get_bus_index(bus)))


func set_volume(bus: StringName, linear: float) -> void:
	var index := AudioServer.get_bus_index(bus)
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(linear, 0.0001)))
	AudioServer.set_bus_mute(index, linear <= 0.001)
	var config := ConfigFile.new()
	config.load(SETTINGS_PATH)
	config.set_value("audio", bus, linear)
	config.save(SETTINGS_PATH)


func _load_settings() -> void:
	var config := ConfigFile.new()
	if config.load(SETTINGS_PATH) != OK:
		return
	for bus in [&"Music", &"SFX"]:
		if config.has_section_key("audio", bus):
			var linear: float = config.get_value("audio", bus)
			var index := AudioServer.get_bus_index(bus)
			AudioServer.set_bus_volume_db(index, linear_to_db(maxf(linear, 0.0001)))
			AudioServer.set_bus_mute(index, linear <= 0.001)
