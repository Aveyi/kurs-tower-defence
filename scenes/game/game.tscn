shader = ExtResource("15_outline")

[sub_resource type="QuadMesh" id="QuadMesh_screen"]
size = Vector2(2, 2)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grade"]
shader = ExtResource("16_grade")

[sub_resource type="Environment" id="Environment_main"]
background_mode = 2
sky = SubResource("Sky_main")
ambient_light_source = 3
ambient_light_sky_contribution = 0.6
ambient_light_energy = 0.38
tonemap_mode = 2
tonemap_exposure = 0.78
tonemap_white = 1.3
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.6
glow_enabled = true
glow_intensity = 0.7
glow_bloom = 0.05

[node name="Game" type="Node3D"]
script = ExtResource("1_game")
level = ExtResource("7_level")
tower_types = Array[ExtResource("8_tower_data")]([ExtResource("9_archer"), ExtResource("10_cannon"), ExtResource("11_mage"), ExtResource("12_ice"), ExtResource("13_ballista")])

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

[node name="Sun" type="DirectionalLight3D" parent="."]
rotation = Vector3(-0.85, -0.6, 0)
